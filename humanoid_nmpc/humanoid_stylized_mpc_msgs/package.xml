<?xml version="1.0"?>
<package format="3">
  <name>humanoid_stylized_mpc_msgs</name>
  <version>0.1.0</version>
  <description>Messages for interactive stylized gait design on top of the whole-body humanoid MPC</description>
  <maintainer email="dxa239@nyu.edu">Daniel</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>ocs2_ros2_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
